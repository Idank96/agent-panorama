{% set start, end = report.time_range %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agent Activity Report</title>
<style>
  :root {
    --bg: #f7f8fa; --card: #ffffff; --ink: #1c2430; --muted: #6b7686;
    --line: #e4e8ee; --accent: #3b5bdb; --ok: #1f9d55; --warn: #b7791f;
    --fail: #d64545; --chip: #eef1f7;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 960px; margin: 0 auto; padding: 32px 20px 64px; }
  h1 { font-size: 28px; margin: 0 0 4px; }
  h2 { font-size: 20px; margin: 36px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--line); }
  h3 { font-size: 17px; margin: 0 0 8px; }
  .sub { color: var(--muted); font-size: 13px; margin-bottom: 8px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .card {
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 14px 16px;
  }
  .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .card .value { font-size: 22px; font-weight: 600; margin-top: 4px; }
  .agent {
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 18px 20px; margin-bottom: 16px;
  }
  .agent-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .meta { color: var(--muted); font-size: 13px; margin: 8px 0 12px; }
  .meta b { color: var(--ink); font-weight: 600; }
  ul.actions { margin: 8px 0 0; padding-left: 20px; }
  ul.actions li { margin: 3px 0; }
  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px;
    font-weight: 600; background: var(--chip); color: var(--muted); white-space: nowrap;
  }
  .badge.success { background: #e6f6ec; color: var(--ok); }
  .badge.failure { background: #fbe7e7; color: var(--fail); }
  .badge.human-escalated { background: #fff2dd; color: var(--warn); }
  .footer { color: var(--muted); font-size: 13px; margin-top: 12px; }
  .footer b { color: var(--ink); font-weight: 600; }
  .empty { color: var(--muted); font-style: italic; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Agent Activity Report</h1>
  <div class="sub">Generated {{ report.generated_at | fmt_time }}</div>

  <h2>Agents</h2>
  {% for run in report.runs %}
  <div class="agent">
    <div class="agent-head">
      <h3>{{ loop.index }}. {{ run.name }}</h3>
      <span class="badge {{ run.outcome.value }}">{{ run.outcome.value }}</span>
    </div>
    <div class="meta">
      <div><b>Asked to do:</b> {{ run.input_text or "—" }}</div>
      <div><b>Result:</b> {{ results[run.run_id] or "—" }}</div>
    </div>
    {% if narratives[run.run_id] %}
    <div><b>What it did, step by step:</b></div>
    <ol class="actions">
      {% for line in narratives[run.run_id] %}
      <li>{{ line }}</li>
      {% endfor %}
    </ol>
    {% else %}
    <div class="empty">No steps recorded.</div>
    {% endif %}
    <div class="footer">
      <b>Outcome:</b> {{ run.outcome.value }} ·
      <b>{{ run.action_count | fmt_int }}</b> steps ·
      <b>{{ run.llm_calls | length }}</b> model calls ·
      <b>{{ run.total_tokens | fmt_int }}</b> tokens
    </div>
  </div>
  {% endfor %}

  <h2>Summary</h2>
  <div class="sub">{{ start | fmt_time }} &rarr; {{ end | fmt_time }}</div>
  <div class="cards">
    <div class="card"><div class="label">Agent runs</div><div class="value">{{ report.total_runs | fmt_int }}</div></div>
    <div class="card"><div class="label">Steps</div><div class="value">{{ report.total_steps | fmt_int }}</div></div>
    <div class="card"><div class="label">Tokens</div><div class="value">{{ report.total_tokens | fmt_int }}</div></div>
  </div>
</div>
</body>
</html>
